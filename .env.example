# Anthropic API key for Claude (used by report generator)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub personal access token (used by Vercel UI to commit changes back to the repo)
# Needs: repo scope
GITHUB_TOKEN=ghp_...

# GitHub repo owner and name (e.g., "yourusername" and "wrist-aficionado-competitor-intel")
GITHUB_OWNER=
GITHUB_REPO=wrist-aficionado-competitor-intel

# Default branch name (usually "main")
GITHUB_BRANCH=main

# Simple shared password to protect admin actions (add/remove competitors, upload, trigger)
# Set this in Vercel env vars to lock the dashboard
ADMIN_PASSWORD=change-me

# Vercel Blob token (used for large CSV uploads from the dashboard)
# Auto-set when you enable Blob in Vercel dashboard:
#   Storage → Create Database → Blob → Connect to project
# Without this, file uploads from the dashboard will fail.
BLOB_READ_WRITE_TOKEN=

# Optional: email recipient for weekly reports (used by GitHub Action)
REPORT_EMAIL_TO=
RESEND_API_KEY=

# SE Ranking Data API key. When set, the workflow auto-pulls top keywords and
# new backlinks per competitor each week via the SE Ranking API and feeds the
# data to the report generator. Without this, the workflow falls back to any
# manually uploaded SEMrush CSVs in data/csv/.
# Get a key at https://online.seranking.com/admin.account.html#/integrations/api
# NOTE: if this key runs out of funds the API returns 402 and every keyword and
# backlink section goes blank. Reports will say the source failed rather than
# inventing findings, but the data is genuinely lost for that week.
SE_RANKING_API_KEY=

# Optional. Endpoint of a scraping proxy that can clear bot protection, used
# only for competitor sitemaps. Must contain the literal {url} placeholder:
#   https://api.provider.com/v1/?api_key=KEY&render_js=true&url={url}
# Left unset, sitemaps are fetched directly, which is fine for every competitor
# except aviandco.com (Cloudflare managed challenge, see data/competitors.json).
# A User-Agent change alone does not clear it. Tested 2026-08-11.
SCRAPE_PROXY_URL=
